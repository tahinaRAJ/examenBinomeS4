# Environnement local (secrets, config machine)
.env

# Base de données SQLite locale
writable/*.sqlite
writable/*.sqlite-journal
writable/*.sqlite-wal
writable/*.sqlite-shm

# Fichiers générés par CodeIgniter
writable/cache/*
!writable/cache/index.html
writable/logs/*
!writable/logs/index.html
writable/session/*
!writable/session/index.html
writable/debugbar/*
!writable/debugbar/.gitkeep
writable/uploads/*
!writable/uploads/index.html

# Dépendances
vendor/

# Documentation et template de référence (non versionnés)
docs/

# IDE / OS
.vscode/
.idea/
.DS_Store
